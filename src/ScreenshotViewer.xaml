<Window x:Class="RecordSummary.ScreenshotViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скриншот" Width="1100" Height="760" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ThemeMode="System">
    <Window.Resources>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Image x:Name="Picture" Margin="12" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               MouseLeftButtonDown="Picture_MouseDown" Cursor="Hand" ToolTip="Дважды щёлкните, чтобы открыть в программе просмотра"/>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrevButton" Click="Prev_Click" ToolTip="Предыдущий (←)" AutomationProperties.Name="Предыдущий">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;"/>
                    </Button>
                    <TextBlock x:Name="CounterText" Margin="12,0" VerticalAlignment="Center" MinWidth="64" TextAlignment="Center"/>
                    <Button x:Name="NextButton" Click="Next_Click" ToolTip="Следующий (→)" AutomationProperties.Name="Следующий">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;"/>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TimeText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" FontFamily="Consolas"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Click="Listen_Click" Style="{DynamicResource AccentButtonStyle}" ToolTip="Включить запись с момента снимка">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,8,0"/><TextBlock Text="Слушать с этого места"/></StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Click="Copy_Click" ToolTip="Скопировать картинку" AutomationProperties.Name="Скопировать">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;"/>
                    </Button>
                    <Button Margin="8,0,0,0" Click="ShowInFolder_Click" ToolTip="Показать в папке" AutomationProperties.Name="Показать в папке">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;"/>
                    </Button>
                    <Button Margin="8,0,0,0" Click="Delete_Click" ToolTip="Удалить скриншот (в корзину)" AutomationProperties.Name="Удалить">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
