<Window x:Class="RecordSummary.CallsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RecordSummary — записи" Width="1080" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" ThemeMode="System">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Строка списка звонков как пункт навигации в "Параметрах" Windows 11 -->
        <Style x:Key="CallItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Padding="12,8">
                            <Grid>
                                <Rectangle x:Name="Pill" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Margin="-12,0,0,0"
                                           HorizontalAlignment="Left" Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="290"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- СПИСОК ЗВОНКОВ -->
        <Grid x:Name="CallsSidebar" Margin="8,12,4,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Grid Margin="4,0,4,8">
                <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" Padding="30,0,0,0" VerticalContentAlignment="Center"/>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="11,0,0,0" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="SearchHint" Text="Поиск по звонкам" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
            <ListBox x:Name="CallsList" Grid.Row="1" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource CallItem}"
                     SelectionChanged="CallsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12" Margin="12,12,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="MetaText" Text="{Binding Meta}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter TargetName="MetaText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Recording">
                                <Setter TargetName="MetaText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Processing">
                                <Setter TargetName="MetaText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyListText" Grid.Row="1" Style="{StaticResource Hint}" Margin="14,16,14,0" Visibility="Collapsed"/>
        </Grid>

        <!-- ЗВОНОК -->
        <Grid x:Name="CallDetails" Grid.Column="1" Margin="20,16,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="PlayerRow" Height="Auto"/>
                <RowDefinition x:Name="ContentRow"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid x:Name="CallHeader">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" MouseLeftButtonDown="Title_MouseDown"
                               ToolTip="Дважды щёлкните, чтобы переименовать"/>
                    <TextBox x:Name="TitleEdit" FontSize="18" Visibility="Collapsed" KeyDown="TitleEdit_KeyDown" LostFocus="TitleEdit_LostFocus"/>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="CopyButton" Click="Copy_Click" ToolTip="Скопировать саммари в Markdown" AutomationProperties.Name="Копировать">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,8,0"/><TextBlock Text="Копировать"/></StackPanel>
                    </Button>
                    <Button Margin="6,0,0,0" Click="OpenFolder_Click" ToolTip="Открыть папку звонка" AutomationProperties.Name="Открыть папку">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;"/>
                    </Button>
                    <Button x:Name="MoreButton" Margin="6,0,0,0" Click="More_Click" ToolTip="Ещё" AutomationProperties.Name="Ещё">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE712;"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Переименовать" Click="Rename_Click"/>
                                <MenuItem x:Name="ResummarizeItem" Header="Заново сделать саммари" ToolTip="По готовому транскрипту, без распознавания — например, после смены промта или модели" Click="Resummarize_Click"/>
                                <MenuItem x:Name="ReprocessItem" Header="Заново распознать и сделать саммари" Click="Reprocess_Click"/>
                                <MenuItem Header="Открыть transcript.md" Click="OpenTranscript_Click"/>
                                <Separator/>
                                <MenuItem Header="Удалить звонок…" Click="Delete_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Margin="6,0,0,0" Click="Settings_Click" ToolTip="Настройки" AutomationProperties.Name="Настройки">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Плеер -->
            <Border x:Name="PlayerCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Видео экрана: идёт вместе со звуком; вне записанных фрагментов — подсказка -->
                    <Grid x:Name="VideoPanel" Height="320" Margin="0,0,0,12" Background="Black" Visibility="Collapsed"
                          MouseLeftButtonDown="VideoPanel_MouseDown" ToolTip="Дважды щёлкните, чтобы открыть фрагмент в проигрывателе">
                        <MediaElement x:Name="VideoView" LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True" ScrubbingEnabled="True"
                                      Stretch="Uniform" MediaOpened="Video_MediaOpened" MediaFailed="Video_MediaFailed"/>
                        <TextBlock x:Name="VideoHint" Foreground="#B0B0B0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="24"/>
                        <Button x:Name="ExpandVideoButton" Content="Развернуть" Click="ExpandVideo_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                ToolTip="Развернуть видео на всё окно" AutomationProperties.Name="Развернуть видео"/>
                    </Grid>
                    <StackPanel Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayButton" Width="40" Height="40" Padding="0" Click="Play_Click" Style="{DynamicResource AccentButtonStyle}"
                                ToolTip="Воспроизведение / пауза (пробел)" AutomationProperties.Name="Воспроизведение">
                            <TextBlock x:Name="PlayIcon" Style="{StaticResource Icon}" FontSize="16" Text="&#xE768;" HorizontalAlignment="Center"/>
                        </Button>
                        <TextBlock x:Name="TimeText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="13"/>
                        <ToggleButton x:Name="VideoToggle" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,12,0" IsChecked="True"
                                      Visibility="Collapsed" Checked="VideoToggle_Changed" Unchecked="VideoToggle_Changed" ToolTip="Показать или скрыть видео экрана">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE714;" Margin="0,0,8,0"/><TextBlock Text="Видео"/></StackPanel>
                        </ToggleButton>
                        <ComboBox x:Name="SpeedCombo" Grid.Column="3" Width="86" VerticalAlignment="Center" SelectionChanged="Speed_SelectionChanged" ToolTip="Скорость"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="Слушать:" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton x:Name="TrackBoth" GroupName="Tracks" Content="оба" IsChecked="True" MinWidth="0" Margin="0,0,10,0" Checked="Tracks_Checked"/>
                            <RadioButton x:Name="TrackMe" GroupName="Tracks" Content="я" MinWidth="0" Margin="0,0,10,0" Checked="Tracks_Checked"/>
                            <RadioButton x:Name="TrackThem" GroupName="Tracks" Content="собеседник" MinWidth="0" Checked="Tracks_Checked"/>
                        </StackPanel>
                    </Grid>
                    <!-- Карта разговора: скриншоты, кто когда говорил; клик — перемотка -->
                    <Grid Margin="0,8,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="16"/><RowDefinition Height="16"/></Grid.RowDefinitions>
                        <TextBlock x:Name="ShotsLabel" Text="Экран" Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center" Visibility="Hidden"/>
                        <TextBlock Grid.Row="1" Text="Я" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Text="Собеседник" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <Canvas x:Name="Timeline" Grid.Column="1" Grid.RowSpan="3" Background="Transparent" ClipToBounds="True" Cursor="Hand"
                                MouseLeftButtonDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove" SizeChanged="Timeline_SizeChanged"/>
                    </Grid>
                    <TextBlock x:Name="PlayerError" Style="{StaticResource Hint}" Margin="0,6,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Саммари / транскрипт -->
            <Grid x:Name="CallContent" Grid.Row="2">
            <TabControl x:Name="Tabs" Padding="0,8,0,0">
                <TabItem Header="Саммари">
                    <ScrollViewer x:Name="SummaryScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SummaryPanel" Margin="2,4,12,12" MaxWidth="820" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Транскрипт">
                    <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TranscriptPanel" Margin="0,4,12,12" MaxWidth="820" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="ShotsTab" Header="Скриншоты" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="ShotsPanel" Margin="0,4,0,12"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Нет звонка / не обработан / ошибка / идёт запись -->
            <Border x:Name="StatePanel" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="24,20"
                    VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="StateTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StateText" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    <ProgressBar x:Name="StateProgress" Height="4" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                    <Button x:Name="StateButton" Margin="0,14,0,0" HorizontalAlignment="Left" Style="{DynamicResource AccentButtonStyle}" Click="StateButton_Click"/>
                </StackPanel>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
