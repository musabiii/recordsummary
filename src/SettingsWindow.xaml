<Window x:Class="RecordSummary.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RecordSummary — настройки" Width="920" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" ThemeMode="System">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,18,0,8"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Пункт навигации как в "Параметрах" Windows 11: лёгкая подсветка и акцентная полоска слева -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Padding="12,9">
                            <Grid>
                                <Rectangle x:Name="Pill" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="-12,0,0,0"
                                           HorizontalAlignment="Left" Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Margin" Value="28,24,28,24"/>
            <Setter Property="MaxWidth" Value="860"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Навигация -->
        <ListBox x:Name="Nav" Margin="8,20,4,8" BorderThickness="0" Background="Transparent" SelectionChanged="Nav_SelectionChanged"
                 ItemContainerStyle="{StaticResource NavItem}">
            <ListBoxItem Tag="General" IsSelected="True">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/><TextBlock Text="Основное"/></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Calls">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE717;"/><TextBlock Text="Звонки"/></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Speech">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;"/><TextBlock Text="Распознавание"/></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Summary">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;"/><TextBlock Text="Саммари"/></StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="About">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE946;"/><TextBlock Text="О программе"/></StackPanel>
            </ListBoxItem>
        </ListBox>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- ОСНОВНОЕ -->
                <StackPanel x:Name="GeneralPage" Style="{StaticResource Page}">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Основное"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="AutoRecordCheck" Content="Записывать звонки без вопроса"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0" Text="Выключено — при звонке появляется предложение записать, запись начинается по нажатию «Записать». Во многих странах на запись разговора нужно согласие всех участников — предупреждайте собеседников."/>
                            <CheckBox x:Name="WidgetCheck" Margin="0,12,0,0" Content="Показывать окошко записи поверх окон"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0" Text="Как в Notion: при звонке — «Записать?», во время записи — таймер, уровни звука обеих сторон, пауза и стоп. Не забирает фокус у окна звонка, его можно перетащить. Выключено — вместо него уведомления Windows."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Папка для записей"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Для каждого звонка создаётся папка: mic.wav, system.wav, transcript.md, summary.md. Пусто — Документы\RecordSummary."/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputDirBox"/>
                                <Button Grid.Column="1" Content="Обзор…" Margin="8,0,0,0" Click="BrowseOutput_Click"/>
                                <Button Grid.Column="2" Content="Открыть" Margin="8,0,0,0" Click="OpenOutput_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Label}" Text="Видео экрана"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Картинка пишется отдельно от звука и синхронно с ним: в окне «Записи» видно, что было на экране в любой момент разговора. Час видео 1080p — примерно 0,3–1 ГБ, на статичной картинке меньше."/>
                                </StackPanel>
                                <ComboBox x:Name="VideoModeCombo" Grid.Column="1" Width="240" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Label}" Text="Что снимать"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Окно звонка пишется, даже если его перекрыть другим окном. Для звонков в браузере и в Teams из Microsoft Store снимается монитор."/>
                                </StackPanel>
                                <ComboBox x:Name="VideoSourceCombo" Grid.Column="1" Width="240" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Качество" VerticalAlignment="Center"/>
                                <ComboBox x:Name="VideoQualityCombo" Grid.Column="1" Width="240" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="CompressCheck" Content="Сжимать записи после распознавания"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0" Text="Каждая дорожка — в моно MP3: час звонка займёт около 60 МБ вместо ~4 ГБ. Для прослушивания и повторного распознавания качества хватает."/>
                            <Grid Margin="28,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="WavInfo" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Button x:Name="CompressNowButton" Grid.Column="1" Content="Сжать сейчас" Click="CompressNow_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <CheckBox x:Name="AutostartCheck" Content="Запускать при входе в Windows"/>
                    </Border>
                </StackPanel>

                <!-- ЗВОНКИ -->
                <StackPanel x:Name="CallsPage" Style="{StaticResource Page}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Звонки"/>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Label}" Text="Считать звонком через"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Сколько приложение должно держать микрофон. Отсекает голосовой поиск и короткие проверки микрофона."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider x:Name="StartDelaySlider" Width="180" Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="StartDelayValue" Width="64" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Label}" Text="Звонок закончился, если микрофон свободен"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Запись останавливается сама. Больше — не обрывается, если приложение на миг отпустило микрофон."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider x:Name="StopDelaySlider" Width="180" Minimum="2" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="StopDelayValue" Width="64" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource Group}" Text="Приложения для звонков"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0" Text="Звонок определяется, когда микрофон держит приложение из списка. Фрагмент ищется в пути к exe (обычные программы) или в имени пакета (Microsoft Store: новый Teams, WhatsApp)."/>
                            <DataGrid x:Name="AppsGrid" Margin="0,12,0,0" Height="240" AutoGenerateColumns="False" CanUserAddRows="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Фрагмент имени" Binding="{Binding Pattern}" Width="*"/>
                                    <DataGridTextColumn Header="Название в уведомлениях" Binding="{Binding Name}" Width="220"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Удалить выбранные" Click="DeleteApps_Click"/>
                                <Button Content="Стандартный список" Margin="8,0,0,0" Click="ResetApps_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Label}" Text="Сейчас микрофон держат"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Начните звонок в нужной программе и нажмите «Обновить» — её можно добавить в список одной кнопкой."/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Обновить" VerticalAlignment="Center" Click="RefreshMicUsers_Click"/>
                            </Grid>
                            <ListBox x:Name="MicUsersList" Margin="0,10,0,0" MinHeight="40" MaxHeight="140"/>
                            <TextBlock x:Name="MicUsersHint" Style="{StaticResource Hint}"/>
                            <Button Content="Добавить выбранное в список" HorizontalAlignment="Left" Margin="0,8,0,0" Click="AddMicUser_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- РАСПОЗНАВАНИЕ -->
                <StackPanel x:Name="SpeechPage" Style="{StaticResource Page}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Распознавание"/>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Label}" Text="Модель whisper"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Файлы ggml-*.bin из папки models. large-v3-turbo — лучший баланс скорости и точности; если её нет, скачается сама (~550 МБ)."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="WhisperModelCombo" Width="320"/>
                                <Button Content="Обзор…" Margin="8,0,0,0" Click="BrowseWhisper_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Label}" Text="Язык звонков"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Если звонки на одном языке, укажите его — так точнее и быстрее."/>
                            </StackPanel>
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="320" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource Group}" Text="Ускорение"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="UseGpuCheck" Content="Использовать видеокарту (Vulkan)" Checked="UseGpu_Changed" Unchecked="UseGpu_Changed"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0" Text="Для распознавания и для локальной модели саммари. Без видеокарты обработка звонка в несколько раз медленнее."/>
                            <Grid Margin="28,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Видеокарта" VerticalAlignment="Center"/>
                                <ComboBox x:Name="GpuCombo" Grid.Column="1" Width="380" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- САММАРИ -->
                <StackPanel x:Name="SummaryPage" Style="{StaticResource Page}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Саммари"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Чем делать саммари"/>
                            <RadioButton x:Name="ProviderLocal" GroupName="Provider" Margin="0,10,0,0" Content="Локальная модель — всё остаётся на компьютере" Checked="Provider_Changed"/>
                            <RadioButton x:Name="ProviderApi" GroupName="Provider" Margin="0,6,0,0" Content="Через API — OpenRouter, Ollama, LM Studio" Checked="Provider_Changed"/>
                            <RadioButton x:Name="ProviderOff" GroupName="Provider" Margin="0,6,0,0" Content="Не делать — только транскрипт" Checked="Provider_Changed"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="LocalPanel">
                        <TextBlock Style="{StaticResource Group}" Text="Локальная модель"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource Label}" Text="Модель"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="Файлы *.gguf из папки models. Для саммари нужна модель от 7B: 3B теряет задачи и путает решения. Qwen2.5-7B скачается сама (~4,7 ГБ)."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="LocalModelCombo" Width="320"/>
                                        <Button Content="Обзор…" Margin="8,0,0,0" Click="BrowseLocal_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource Label}" Text="Контекст"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="Сколько текста модель видит за раз. Звонок длиннее делится на части: сначала заметки по частям, потом итог. Больше контекст — цельнее саммари, но нужно больше видеопамяти."/>
                                    </StackPanel>
                                    <ComboBox x:Name="ContextCombo" Grid.Column="1" Width="240" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ApiPanel">
                        <TextBlock Style="{StaticResource Group}" Text="API"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource Label}" Text="Сервис"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="Любой OpenAI-совместимый сервер. Ollama и LM Studio работают на этом же компьютере."/>
                                    </StackPanel>
                                    <ComboBox x:Name="ApiPresetCombo" Grid.Column="1" Width="240" VerticalAlignment="Center" SelectionChanged="ApiPreset_SelectionChanged"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Адрес" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ApiUrlBox" Grid.Column="1" TextChanged="ApiUrl_TextChanged"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Ключ API" VerticalAlignment="Center"/>
                                    <PasswordBox x:Name="ApiKeyBox" Grid.Column="1"/>
                                </Grid>
                                <TextBlock x:Name="ApiKeyHint" Style="{StaticResource Hint}" Margin="140,2,0,0"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Модель" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ApiModelCombo" Grid.Column="1" IsEditable="True"/>
                                    <Button x:Name="LoadModelsButton" Grid.Column="2" Content="Загрузить список" Margin="8,0,0,0" Click="LoadModels_Click"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ApiTestResult" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,16,0" Text="Короткий запрос с этими настройками — проверить адрес, ключ и модель."/>
                                    <Button x:Name="ApiTestButton" Grid.Column="1" MinWidth="150" Content="Проверить" Click="ApiTest_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Group}" Text="Готовые записи"/>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,16,0" Text="Заново распознать и сделать саммари записанного звонка — например, после смены модели. Используются применённые настройки."/>
                            <Button x:Name="ReprocessButton" Grid.Column="1" MinWidth="150" Content="Выбрать звонок…" Click="Reprocess_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- О ПРОГРАММЕ -->
                <StackPanel x:Name="AboutPage" Style="{StaticResource Page}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="О программе"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold" Text="RecordSummary"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Замечает звонок, записывает его двумя дорожками и делает транскрипт и саммари. Распознавание — на этом компьютере (whisper.cpp через Vulkan), саммари — локально или через выбранный API."/>
                            <TextBlock x:Name="AboutStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <WrapPanel>
                            <Button Content="Открыть config.json" Margin="0,0,8,0" Click="OpenConfig_Click"/>
                            <Button Content="Открыть лог" Margin="0,0,8,0" Click="OpenLog_Click"/>
                            <Button Content="Папка с моделями" Click="OpenModels_Click"/>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OkButton" Content="ОК" MinWidth="100" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Ok_Click"/>
                    <Button Content="Отмена" MinWidth="100" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="ApplyButton" Content="Применить" MinWidth="100" Margin="8,0,0,0" Click="Apply_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
