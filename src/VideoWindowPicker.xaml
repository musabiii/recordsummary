<Window x:Class="RecordSummary.VideoWindowPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор окна для видео" WindowStyle="None" AllowsTransparency="True"
        Background="#01000000" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Cursor="Cross" PreviewKeyDown="Picker_KeyDown"
        PreviewMouseUp="Picker_MouseUp">
    <Canvas Background="Transparent" ClipToBounds="True">
        <Border x:Name="Highlight" Background="#553B82F6" BorderBrush="#FF60A5FA" BorderThickness="4"
                CornerRadius="4" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Border x:Name="HintPanel" Canvas.ZIndex="1" Width="560" Padding="20,16" CornerRadius="10"
                Background="#FF20242C" BorderBrush="#FF596171" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Наведите на окно и нажмите, чтобы выбрать" Foreground="White" FontSize="17"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="SourceTitle" Text="Esc — отменить выбор" Foreground="#FFD3DAE6" Margin="0,8,0,14"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Список окон и мониторов…" Click="List_Click" Padding="12,6"/>
                    <Button Content="Отмена (Esc)" Click="Cancel_Click" Margin="10,0,0,0" Padding="12,6"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
